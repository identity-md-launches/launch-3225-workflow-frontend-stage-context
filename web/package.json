  },
  "devDependencies": {
    "@axe-core/playwright": "4.11.0",
    "@types/node": "24.10.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "@vitejs/plugin-react": "5.1.1",
    "playwright": "1.56.1",
    "typescript": "5.9.3",
    "vite": "7.2.2"
  }
